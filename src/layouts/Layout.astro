---
// src/layouts/Layout.astro
//
// Este archivo SÍ va dentro de src/ -> src/layouts/Layout.astro
// Astro no fuerza una estructura exacta, pero "layouts" es la carpeta
// convencional para los componentes que envuelven páginas enteras
// (el <html>, <head>, header/footer compartidos, etc.), separados de
// "components", que son piezas más chicas y reutilizables (Hero,
// cards, botones...). Mantener esa separación ayuda a que el proyecto
// se lea igual para cualquiera que abra la carpeta src/.

import "../styles/global.css";
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CESOB — Centro de Estudios del Sudoeste Bonaerense",
  description = "Centro de Estudios del Sudoeste Bonaerense: jornadas, charlas y producción académica sobre la región.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/logo.png" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="CESOB - Centro de Estudios del Sudoeste Bonaerense" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://cesob.vercel.app/images/logo.png" />

    <!-- Twitter / X Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="CESOB - Centro de Estudios del Sudoeste Bonaerense" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cesob.vercel.app/images/logo.png" />
  </head>
  <body class="font-sans">
    <Header />
    <slot />
    <Footer />
  </body>
</html>