---
// src/components/TeamCard.astro
//
// La separo en su propio archivo (en vez de escribir el HTML de la
// card directo dentro de QuienesSomos.astro) porque así podés
// reutilizarla el día de mañana en otro lado (por ejemplo, si en el
// futuro cada "Jornada" muestra quién dio la charla con esta misma
// tarjeta) sin copiar y pegar el diseño.

interface Props {
  name: string;
  role: string;
  bio?: string;
  photo: string;
}

const { name, role, bio, photo } = Astro.props;
---

<article
  class="flex flex-col items-center rounded-2xl bg-cesob-mist p-6 text-center transition-shadow hover:shadow-md sm:p-8"
>
  <img
    src={photo}
    alt={`Foto de ${name}`}
    class="h-24 w-24 rounded-full object-cover ring-4 ring-white sm:h-28 sm:w-28"
    loading="lazy"
  />

  <h3 class="mt-5 text-lg font-bold text-cesob-ink">{name}</h3>
  <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-cesob-blue-dark">
    {role}
  </p>

  {bio && <p class="mt-3 text-sm leading-relaxed text-cesob-ink/70">{bio}</p>}
</article>