<section id="quienes-somos" class="mx-auto max-w-6xl px-6 py-20 sm:px-10 sm:py-28 lg:px-16">
  <div class="max-w-2xl">
    <span class="text-sm font-semibold uppercase tracking-[0.2em] text-cesob-blue-dark">
      Quiénes somos
    </span>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-cesob-ink sm:text-4xl">
      El equipo detrás de CESOB
    </h2>
  </div>

  <!--
    Grilla mobile-first:
    - grid-cols-1: en mobile, una card por fila (default, sin prefijo).
    - sm:grid-cols-2: desde ~640px, dos columnas.
    - lg:grid-cols-3: desde ~1024px, tres columnas.
    Siempre se escribe así, de la pantalla chica a la grande, nunca al
    revés: es la esencia de "mobile first" en Tailwind.
  -->
  <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {team.map((member) => <TeamCard {...member} />)}
  </div>
</section>